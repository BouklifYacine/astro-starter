---
import PageLayout from './PageLayout.astro';
import type { ResolvedSeo } from '@/lib/seo';
import type { SchemaGraph } from '@/lib/schema-org';

interface Props {
  seo: ResolvedSeo;
  schema?: SchemaGraph | SchemaGraph[];
}

const { seo, schema } = Astro.props;
---

<PageLayout seo={seo} schema={schema}>
  <article class="container-shell section-space">
    <slot />
  </article>
</PageLayout>
