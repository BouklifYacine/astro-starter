<section class="system-map" aria-labelledby="system-map-title">
  <div class="system-map__heading">
    <div>
      <h2 id="system-map-title">Le modèle mental complet</h2>
      <p>Choisis un circuit, puis sélectionne un nœud du SVG pour expliquer son rôle.</p>
    </div>

    <div class="system-map__tabs" role="tablist" aria-label="Circuits Astro">
      <button type="button" role="tab" aria-selected="true" aria-controls="diagram-rendu" id="tab-rendu" data-diagram-tab="rendu">Rendu</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="diagram-ilots" id="tab-ilots" data-diagram-tab="ilots">Îlots</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="diagram-requete" id="tab-requete" data-diagram-tab="requete">Requête</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="diagram-contenu" id="tab-contenu" data-diagram-tab="contenu">Contenu</button>
    </div>
  </div>

  <div class="system-map__panel" id="diagram-rendu" role="tabpanel" aria-labelledby="tab-rendu" data-diagram-panel="rendu">
    <svg viewBox="0 0 360 560" role="img" aria-labelledby="rendu-title rendu-desc">
      <title id="rendu-title">Arbre de décision du mode de rendu Astro</title>
      <desc id="rendu-desc">Une question initiale mène vers une page statique, un îlot serveur ou une route rendue à la demande.</desc>
      <defs>
        <marker id="rendu-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 Z" fill="currentColor"></path>
        </marker>
      </defs>

      <path class="diagram-line" d="M180 108 V145" marker-end="url(#rendu-arrow)"></path>
      <path class="diagram-line" d="M180 238 V275" marker-end="url(#rendu-arrow)"></path>
      <path class="diagram-line" d="M180 368 V405" marker-end="url(#rendu-arrow)"></path>

      <g class="diagram-node diagram-node--question" transform="translate(30 20)">
        <rect width="300" height="88" rx="14"></rect>
        <text x="150" y="36" text-anchor="middle">La donnée dépend-elle</text>
        <text x="150" y="61" text-anchor="middle">de la requête du visiteur ?</text>
      </g>

      <g class="diagram-node is-active" role="button" tabindex="0" aria-pressed="true" data-diagram-node data-info="Non : garde la route statique. Le HTML est produit au build, servi par le CDN et n’attend aucun runtime." transform="translate(30 150)">
        <rect width="300" height="88" rx="14"></rect>
        <text x="24" y="31">NON</text>
        <text class="diagram-node__main" x="24" y="60">Page statique</text>
        <text class="diagram-node__code" x="276" y="60" text-anchor="end">défaut</text>
      </g>

      <g class="diagram-node" role="button" tabindex="0" aria-pressed="false" data-diagram-node data-info="Une petite zone personnalisée ne doit pas rendre toute la page dynamique : `server:defer` la calcule séparément avec un fallback stable." transform="translate(30 280)">
        <rect width="300" height="88" rx="14"></rect>
        <text x="24" y="31">OUI, UNE ZONE</text>
        <text class="diagram-node__main" x="24" y="60">Server island</text>
        <text class="diagram-node__code" x="276" y="60" text-anchor="end">server:defer</text>
      </g>

      <g class="diagram-node" role="button" tabindex="0" aria-pressed="false" data-diagram-node data-info="Une route entière qui lit cookies, session, headers ou corps de requête doit être rendue à la demande par l’adaptateur." transform="translate(30 410)">
        <rect width="300" height="88" rx="14"></rect>
        <text x="24" y="31">OUI, LA ROUTE</text>
        <text class="diagram-node__main" x="24" y="60">Rendu à la demande</text>
        <text class="diagram-node__code" x="276" y="60" text-anchor="end">prerender=false</text>
      </g>

      <text class="diagram-footnote" x="180" y="538" text-anchor="middle">Statique jusqu’à preuve du contraire.</text>
    </svg>
    <p class="system-map__explanation" aria-live="polite" data-diagram-explanation>Non : garde la route statique. Le HTML est produit au build, servi par le CDN et n’attend aucun runtime.</p>
  </div>

  <div class="system-map__panel" id="diagram-ilots" role="tabpanel" aria-labelledby="tab-ilots" data-diagram-panel="ilots" hidden>
    <svg viewBox="0 0 360 610" role="img" aria-labelledby="ilots-title ilots-desc">
      <title id="ilots-title">Échelle de coût des composants interactifs Astro</title>
      <desc id="ilots-desc">Quatre choix classés du HTML statique au composant hydraté dans le navigateur.</desc>
      <path class="diagram-spine" d="M44 82 V520"></path>

      <g class="diagram-node is-active" role="button" tabindex="0" aria-pressed="true" data-diagram-node data-info="Un composant `.astro` rend du HTML et zéro runtime client. C’est la solution normale pour le contenu, les layouts et les composants sans état navigateur." transform="translate(30 30)">
        <circle cx="14" cy="52" r="10"></circle>
        <rect x="38" width="292" height="104" rx="14"></rect>
        <text x="62" y="31">0 KO DE RUNTIME</text>
        <text class="diagram-node__main" x="62" y="62">Composant Astro</text>
        <text class="diagram-node__sub" x="62" y="86">HTML, props, slots, CSS scoped</text>
      </g>

      <g class="diagram-node" role="button" tabindex="0" aria-pressed="false" data-diagram-node data-info="Pour un toggle, un accordéon ou une préférence locale, un script natif traité par Astro coûte moins qu’un framework et reste facile à isoler." transform="translate(30 158)">
        <circle cx="14" cy="52" r="10"></circle>
        <rect x="38" width="292" height="104" rx="14"></rect>
        <text x="62" y="31">PETIT COMPORTEMENT DOM</text>
        <text class="diagram-node__main" x="62" y="62">Script natif</text>
        <text class="diagram-node__sub" x="62" y="86">Bundlé et dédupliqué par Astro</text>
      </g>

      <g class="diagram-node" role="button" tabindex="0" aria-pressed="false" data-diagram-node data-info="Un composant React, Vue ou Svelte devient un îlot uniquement avec `client:*`. Choisis la directive selon l’urgence réelle de l’interaction." transform="translate(30 286)">
        <circle cx="14" cy="52" r="10"></circle>
        <rect x="38" width="292" height="104" rx="14"></rect>
        <text x="62" y="31">ÉTAT INTERACTIF COMPLEXE</text>
        <text class="diagram-node__main" x="62" y="62">Îlot client</text>
        <text class="diagram-node__sub" x="62" y="86">load · idle · visible · media</text>
      </g>

      <g class="diagram-node" role="button" tabindex="0" aria-pressed="false" data-diagram-node data-info="Si le besoin est une donnée serveur lente ou personnalisée, `server:defer` diffère le fragment sans livrer le runtime d’un framework au navigateur." transform="translate(30 414)">
        <circle cx="14" cy="52" r="10"></circle>
        <rect x="38" width="292" height="104" rx="14"></rect>
        <text x="62" y="31">DONNÉE SERVEUR DIFFÉRÉE</text>
        <text class="diagram-node__main" x="62" y="62">Îlot serveur</text>
        <text class="diagram-node__sub" x="62" y="86">Fallback puis HTML personnalisé</text>
      </g>

      <text class="diagram-footnote" x="180" y="580" text-anchor="middle">Monte l’échelle seulement si le besoin l’exige.</text>
    </svg>
    <p class="system-map__explanation" aria-live="polite" data-diagram-explanation>Un composant `.astro` rend du HTML et zéro runtime client. C’est la solution normale pour le contenu, les layouts et les composants sans état navigateur.</p>
  </div>

  <div class="system-map__panel" id="diagram-requete" role="tabpanel" aria-labelledby="tab-requete" data-diagram-panel="requete" hidden>
    <svg viewBox="0 0 360 650" role="img" aria-labelledby="requete-title requete-desc">
      <title id="requete-title">Pipeline simplifié d’une requête Astro 7</title>
      <desc id="requete-desc">La requête traverse normalisation, sessions, Actions, middleware, rendu et cache.</desc>
      <defs>
        <marker id="request-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 Z" fill="currentColor"></path>
        </marker>
      </defs>

      {[
        ['Entrée HTTP', 'URL · méthode · headers', 'La requête fournit URL, méthode, en-têtes, cookies et éventuellement un corps. Les routes statiques n’en dépendent pas au moment de leur build.'],
        ['Normalisation', 'slash · redirect', 'Astro normalise l’URL et applique les redirections avant d’entrer dans la logique applicative. Une incohérence de slash ajoute des allers-retours inutiles.'],
        ['Session et Action', 'état · mutation', 'Les sessions chargent l’état associé à la visite. Une Action appelée par un formulaire est résolue dans ce pipeline avant le rendu de la page.'],
        ['Middleware', 'auth · locals · headers', 'Le middleware peut autoriser, rediriger et enrichir `locals`. Il doit rester lisible : une logique invisible partout est difficile à diagnostiquer.'],
        ['Route et rendu', 'page · endpoint · rewrite', 'Astro sélectionne la route, exécute l’endpoint ou rend la page. Les redirects et statuts dynamiques doivent être décidés avant que le flux HTML ne parte.'],
        ['Réponse et cache', 'HTML · Response · CDN', 'La réponse finale porte statut, corps et en-têtes. Le cache se vérifie sur une sortie construite et sur le runtime cible, pas seulement dans `astro dev`.'],
      ].map(([title, meta, info], index) => {
        const y = 24 + index * 96;
        return (
          <Fragment>
            {index > 0 && <path class="diagram-line" d={`M180 ${y - 28} V${y - 6}`} marker-end="url(#request-arrow)"></path>}
            <g class:list={['diagram-node', { 'is-active': index === 0 }]} role="button" tabindex="0" aria-pressed={index === 0 ? 'true' : 'false'} data-diagram-node data-info={info} transform={`translate(30 ${y})`}>
              <rect width="300" height="68" rx="14"></rect>
              <text class="diagram-node__main" x="22" y="31">{title}</text>
              <text class="diagram-node__sub" x="278" y="31" text-anchor="end">{meta}</text>
              <text x="22" y="52">ÉTAPE {index + 1}</text>
            </g>
          </Fragment>
        );
      })}
    </svg>
    <p class="system-map__explanation" aria-live="polite" data-diagram-explanation>La requête fournit URL, méthode, en-têtes, cookies et éventuellement un corps. Les routes statiques n’en dépendent pas au moment de leur build.</p>
  </div>

  <div class="system-map__panel" id="diagram-contenu" role="tabpanel" aria-labelledby="tab-contenu" data-diagram-panel="contenu" hidden>
    <svg viewBox="0 0 360 620" role="img" aria-labelledby="contenu-title contenu-desc">
      <title id="contenu-title">Flux d’une collection de contenu Astro</title>
      <desc id="contenu-desc">Une source traverse un loader et un schéma avant d’être requêtée et rendue.</desc>
      <defs>
        <marker id="content-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 Z" fill="currentColor"></path>
        </marker>
      </defs>

      {[
        ['Source', 'Markdown · JSON · CMS', 'La source peut être locale ou distante. Choisis-la selon le workflow éditorial, pas selon l’API que tu préfères utiliser.'],
        ['Loader', 'glob · file · custom · live', 'Le loader sait où et quand récupérer les entrées. Build-time maximise la vitesse ; live privilégie la fraîcheur avec un coût runtime.'],
        ['Schéma', 'Zod · types · validation', 'Le schéma transforme le contenu en contrat : une entrée invalide échoue tôt, avant de devenir une page incomplète en production.'],
        ['Content Layer', 'stockage · cache · index', 'Le Content Layer centralise les entrées et évite de réinventer le chargement et la mise en cache dans chaque composant.'],
        ['Requête', 'getCollection · getEntry', 'La page interroge la collection, filtre et trie explicitement les entrées avant de les passer aux composants.'],
        ['Route rendue', 'getStaticPaths · render', 'Le contenu devient une route statique via `getStaticPaths()` ou une route à la demande si la fraîcheur l’exige réellement.'],
      ].map(([title, meta, info], index) => {
        const y = 20 + index * 94;
        return (
          <Fragment>
            {index > 0 && <path class="diagram-line" d={`M180 ${y - 28} V${y - 6}`} marker-end="url(#content-arrow)"></path>}
            <g class:list={['diagram-node', { 'is-active': index === 0 }]} role="button" tabindex="0" aria-pressed={index === 0 ? 'true' : 'false'} data-diagram-node data-info={info} transform={`translate(30 ${y})`}>
              <rect width="300" height="66" rx="14"></rect>
              <text class="diagram-node__main" x="22" y="29">{title}</text>
              <text class="diagram-node__sub" x="22" y="51">{meta}</text>
            </g>
          </Fragment>
        );
      })}
    </svg>
    <p class="system-map__explanation" aria-live="polite" data-diagram-explanation>La source peut être locale ou distante. Choisis-la selon le workflow éditorial, pas selon l’API que tu préfères utiliser.</p>
  </div>
</section>

<script>
  const maps = document.querySelectorAll<HTMLElement>('.system-map');

  for (const map of maps) {
    const tabs = Array.from(map.querySelectorAll<HTMLButtonElement>('[data-diagram-tab]'));
    const panels = Array.from(map.querySelectorAll<HTMLElement>('[data-diagram-panel]'));

    const activateTab = (tab: HTMLButtonElement) => {
      const target = tab.dataset.diagramTab;
      for (const candidate of tabs) candidate.setAttribute('aria-selected', String(candidate === tab));
      for (const panel of panels) panel.hidden = panel.dataset.diagramPanel !== target;
    };

    for (const tab of tabs) tab.addEventListener('click', () => activateTab(tab));

    for (const panel of panels) {
      const nodes = Array.from(panel.querySelectorAll<SVGGElement>('[data-diagram-node]'));
      const explanation = panel.querySelector<HTMLElement>('[data-diagram-explanation]');

      const activateNode = (node: SVGGElement) => {
        for (const candidate of nodes) {
          candidate.classList.toggle('is-active', candidate === node);
          candidate.setAttribute('aria-pressed', String(candidate === node));
        }
        if (explanation && node.dataset.info) explanation.textContent = node.dataset.info;
      };

      for (const node of nodes) {
        node.addEventListener('click', () => activateNode(node));
        node.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            activateNode(node);
          }
        });
      }
    }
  }
</script>

<style>
  .system-map {
    border-block: 1px solid var(--color-border);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .system-map__heading {
    display: grid;
    gap: 1.5rem;
    margin-block-end: 2rem;
  }

  .system-map__heading h2 {
    max-width: 14ch;
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .system-map__heading p {
    max-width: 58ch;
    margin-block-start: 1rem;
    color: var(--color-muted);
  }

  .system-map__tabs {
    display: flex;
    flex-wrap: wrap;
    align-self: end;
    gap: 0.5rem;
  }

  .system-map__tabs button {
    min-inline-size: auto;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    padding: 0.55rem 0.9rem;
    color: var(--color-ink);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .system-map__tabs button[aria-selected='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .system-map__panel {
    display: grid;
    align-items: center;
    gap: 2rem;
  }

  .system-map__panel[hidden] {
    display: none;
  }

  .system-map svg {
    display: block;
    width: min(100%, 32rem);
    margin-inline: auto;
    color: var(--color-ink);
    overflow: visible;
  }

  .diagram-line,
  .diagram-spine {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 2;
  }

  .diagram-node {
    cursor: pointer;
    outline: none;
  }

  .diagram-node rect {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1.5;
    transition: fill 180ms ease-out, stroke 180ms ease-out;
  }

  .diagram-node circle {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 2;
    transition: fill 180ms ease-out, stroke 180ms ease-out;
  }

  .diagram-node text {
    fill: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .diagram-node__main {
    fill: var(--color-ink) !important;
    font-size: 17px !important;
    font-weight: 700 !important;
    letter-spacing: -0.02em !important;
  }

  .diagram-node__sub,
  .diagram-node__code {
    font-size: 10px !important;
    letter-spacing: 0 !important;
  }

  .diagram-node--question {
    cursor: default;
  }

  .diagram-node--question text {
    fill: var(--color-ink);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .diagram-node.is-active rect,
  .diagram-node:focus-visible rect {
    fill: color-mix(in oklch, var(--color-brand) 10%, var(--color-surface));
    stroke: var(--color-brand);
    stroke-width: 2.5;
  }

  .diagram-node.is-active circle,
  .diagram-node:focus-visible circle {
    fill: var(--color-brand);
    stroke: var(--color-brand);
  }

  .diagram-footnote {
    fill: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 12px;
  }

  .system-map__explanation {
    max-width: 62ch;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: 1.25rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.5;
  }

  @media (min-width: 52rem) {
    .system-map__heading {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .system-map__panel {
      grid-template-columns: minmax(20rem, 0.9fr) minmax(22rem, 1.1fr);
      min-height: 40rem;
    }

    .system-map__explanation {
      border-block-start: 0;
      border-inline-start: 1px solid var(--color-border);
      padding-block-start: 0;
      padding-inline-start: clamp(2rem, 5vw, 5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-node rect,
    .diagram-node circle {
      transition: none;
    }
  }
</style>
