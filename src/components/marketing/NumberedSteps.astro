---
interface Step { title: string; description: string }
interface Props { title: string; steps: Step[] }
const { title, steps } = Astro.props;
---

<section class="container-shell section-space" aria-labelledby="steps-title">
  <div class="section-heading"><h2 id="steps-title">{title}</h2></div>
  <div class="numbered-list">
    {steps.map((step, index) => (
      <article class="surface-card numbered-item">
        <strong>0{index + 1}</strong>
        <h3>{step.title}</h3>
        <p class="muted">{step.description}</p>
      </article>
    ))}
  </div>
</section>
