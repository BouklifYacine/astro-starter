---
interface Props { title: string; description: string; label: string; href?: string }
const { title, description, label, href = "/contact/" } = Astro.props;
---

<section class="container-shell section-space">
  <div class="surface-card" style="padding: clamp(1.5rem, 5vw, 3rem); background: var(--color-brand-soft);">
    <h2 style="max-width: 18ch; margin: 0; font-size: clamp(2rem, 5vw, 3.75rem); letter-spacing: -0.06em; line-height: 1;">{title}</h2>
    <p class="lead-copy">{description}</p>
    <a class="button-primary" href={href}>{label}</a>
  </div>
</section>
