---
import { site } from "../../config/site.config";
import MobileNavigation from "./MobileNavigation.astro";
---

<header class="site-header">
  <div class="container-shell site-header-inner">
    <a class="site-brand" href="/" aria-label={`${site.name} — accueil`}>{site.name}</a>
    <nav class="site-nav" aria-label="Navigation principale">
      {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <MobileNavigation items={site.navigation} />
  </div>
</header>
