---
interface Testimonial { quote: string; author: string; context: string }
interface Props { items: Testimonial[] }
const { items } = Astro.props;
---

<div class="responsive-grid">
  {items.map((item) => (
    <figure class="surface-card testimonial-card">
      <blockquote>“{item.quote}”</blockquote>
      <figcaption class="muted">{item.author} — {item.context}</figcaption>
    </figure>
  ))}
</div>
