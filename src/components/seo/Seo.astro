---
import { site } from '@/config/site.config';
import type { ResolvedSeo } from '@/lib/seo';
import { organizationSchema, websiteSchema, type SchemaGraph } from '@/lib/schema-org';

interface Props {
  seo: ResolvedSeo;
  schema?: SchemaGraph | SchemaGraph[];
}

const { seo, schema } = Astro.props;

// I6 — every SEO signal is emitted here, server-side, in the initial HTML.
const graphs: SchemaGraph[] = [
  organizationSchema(),
  websiteSchema(),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />

{seo.noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={seo.type} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.image} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.image} />

{seo.publishedAt && <meta property="article:published_time" content={seo.publishedAt} />}
{seo.updatedAt && <meta property="article:modified_time" content={seo.updatedAt} />}

{site.seo.verification.google && (
  <meta name="google-site-verification" content={site.seo.verification.google} />
)}
{site.seo.verification.bing && <meta name="msvalidate.01" content={site.seo.verification.bing} />}

{graphs.map((graph) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
))}
