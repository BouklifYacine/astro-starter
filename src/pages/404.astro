---
Astro.response.status = 404;

import PageLayout from "../layouts/PageLayout.astro";
import { buildSeo } from "../lib/seo";

const seo = buildSeo({
  title: "Page introuvable",
  description: "La page demandée n’existe pas ou a été déplacée.",
  path: "/404/",
  noindex: true,
});
---

<PageLayout seo={seo}>
  <section class="container-shell section-space">
    <div class="surface-card" style="padding: 2rem;">
      <div class="eyebrow">404</div>
      <h1>Cette page n’existe pas.</h1>
      <p class="lead-copy">Vérifiez l’adresse ou revenez à la page d’accueil.</p>
      <a class="button-primary" href="/">Retour à l’accueil</a>
    </div>
  </section>
</PageLayout>
