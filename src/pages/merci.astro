---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site.config';
import { buildSeo } from '../lib/seo';

const seo = buildSeo({
  title: 'Merci',
  description: 'Votre demande a bien été envoyée.',
  path: '/merci/',
  noindex: true,
});
---

<PageLayout seo={seo}>
  <section class="container-shell section-space">
    <div class="surface-card" style="padding: 2rem;">
      <h1>Merci</h1>
      <p class="lead-copy">
        Votre demande a bien été envoyée. Nous revenons vers vous rapidement.
      </p>

      {site.features.booking && site.contact.bookingUrl && (
        <p><a class="button-primary" href={site.contact.bookingUrl}>Réserver un créneau</a></p>
      )}

      <p><a class="button-secondary" href="/">Retour à l’accueil</a></p>
    </div>
  </section>
</PageLayout>
