---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/marketing/Hero.astro';
import ContactSection from '../components/marketing/ContactSection.astro';
import { site } from '../config/site.config';
import { buildSeo } from '../lib/seo';

const seo = buildSeo({
  description: site.seo.defaultDescription,
  path: '/',
});
---

<PageLayout seo={seo}>
  <Hero
    eyebrow="Placeholder"
    title={site.seo.defaultTitle || site.name}
    description={site.seo.defaultDescription}
    primaryCta={site.nav.cta.label}
    primaryHref={site.nav.cta.href}
  />

  <ContactSection />
</PageLayout>
