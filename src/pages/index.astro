---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site.config';
import { buildSeo } from '../lib/seo';

const seo = buildSeo({
  description: site.seo.defaultDescription,
  path: '/',
});
---

<PageLayout seo={seo}>
  <section class="container-shell section-space">
    <div class="section-heading">
      <div class="eyebrow">Bienvenue</div>
      <h1>{site.seo.defaultTitle || site.name}</h1>
      <p>{site.seo.defaultDescription}</p>
      <p>
        <a class="button-primary" href={site.nav.cta.href}>{site.nav.cta.label}</a>
      </p>
    </div>
  </section>
</PageLayout>
