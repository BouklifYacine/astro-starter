---
import AstroSystemMap from '@/components/learning/AstroSystemMap.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { masteryTopics } from '@/data/astro-mastery';
import { buildSeo } from '@/lib/seo';

const seo = buildSeo({
  title: 'Maîtriser Astro — manuel du starter',
  description: 'Les 15 notions Astro à connaître par cœur, classées par importance et reliées à des exemples de production.',
  path: '/maitriser-astro/',
});

const directionContract = `
THESIS: Un plan de vol rend visibles les frontières build, serveur et navigateur; il refuse le tableau de documentation sans modèle mental.
OWN-WORLD: Surface claire du starter, encre sombre, bleu de marque, règles fines, grands jalons typographiques et schémas vectoriels précis.
STORY: Le lecteur comprend le système complet, suit quinze compétences ordonnées, vérifie chaque notion dans le dépôt et mesure sa progression.
FIRST VIEWPORT: Titre massif à gauche, barème et progression à droite, puis la chaîne build vers navigateur comme point d'entrée.
FORM: Manuel de vol interactif, structure attribuée en position sept, seed cab1e356.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
`.trim();

const score = (value: number) => Number.isInteger(value) ? value.toFixed(0) : value.toFixed(1).replace('.', ',');
---

<BaseLayout seo={seo} bodyClass="mastery-page" directionContract={directionContract}>
  <header class="mastery-header">
    <a class="mastery-brand" href="/" aria-label="Retour à l’accueil du starter">
      <span aria-hidden="true">A/</span>
      <span>Manuel du starter</span>
    </a>
    <nav aria-label="Navigation du manuel">
      <a href="#modele-mental">Modèle mental</a>
      <a href="#classement">Classement</a>
      <a href="#parcours">Parcours</a>
    </nav>
    <span class="mastery-internal">Interne · noindex</span>
  </header>

  <main id="main">
    <section class="mastery-hero" aria-labelledby="mastery-title">
      <div class="mastery-hero__copy">
        <h1 id="mastery-title">Maîtriser Astro, de la sortie HTML au runtime.</h1>
        <p>
          Quinze notions à connaître par cœur pour raisonner correctement sur un projet Astro,
          construire un starter portable et éviter les erreurs qui n’apparaissent qu’en production.
        </p>
      </div>

      <aside class="mastery-score" aria-label="Méthode de priorisation">
        <p class="mastery-score__formula">50 / 30 / 20</p>
        <p>
          Chaque note combine <strong>l’impact architectural</strong> à 50 %,
          <strong>la fréquence d’usage</strong> à 30 % et
          <strong>le coût d’une erreur</strong> à 20 %.
        </p>
        <p class="mastery-score__note">Barème pédagogique, pas statistique officielle d’Astro.</p>
      </aside>
    </section>

    <section class="mastery-progress" aria-labelledby="progress-title">
      <div>
        <h2 id="progress-title">Ta progression</h2>
        <p><strong data-progress-count>0 / 15</strong> notions maîtrisées sur cet appareil.</p>
      </div>
      <progress value="0" max={masteryTopics.length} data-progress-bar>0 sur {masteryTopics.length}</progress>
      <button type="button" data-reset-progress>Réinitialiser</button>
    </section>

    <div class="mastery-shell">
      <section class="mastery-method" aria-labelledby="method-title">
        <h2 id="method-title">Comment l’utiliser</h2>
        <ol>
          <li><strong>Explique</strong> la notion sans regarder la réponse.</li>
          <li><strong>Retrouve</strong> son implémentation dans le starter.</li>
          <li><strong>Fais</strong> l’exercice en moins de cinq minutes.</li>
          <li><strong>Coche</strong> uniquement si tu pourrais justifier la décision en revue de code.</li>
        </ol>
      </section>

      <div id="modele-mental">
        <AstroSystemMap />
      </div>

      <section class="mastery-ranking" id="classement" aria-labelledby="ranking-title">
        <div class="mastery-section-heading">
          <h2 id="ranking-title">Le classement des 15 notions</h2>
          <p>Les scores proches ne signifient pas que les sujets sont interchangeables : les premières notions conditionnent toutes les suivantes.</p>
        </div>

        <div class="mastery-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Rang</th>
                <th scope="col">Notion</th>
                <th scope="col">Catégorie</th>
                <th scope="col">Importance</th>
                <th scope="col">État</th>
              </tr>
            </thead>
            <tbody>
              {masteryTopics.map((topic) => (
                <tr>
                  <td class="mastery-rank">{topic.rank.toString().padStart(2, '0')}</td>
                  <th scope="row"><a href={`#${topic.id}`}>{topic.title}</a></th>
                  <td>{topic.category}</td>
                  <td><strong>{score(topic.score)} / 20</strong></td>
                  <td><span class="mastery-state" data-topic-state={topic.id}>À apprendre</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="mastery-curriculum" id="parcours" aria-labelledby="curriculum-title">
        <div class="mastery-section-heading">
          <h2 id="curriculum-title">Le parcours à connaître par cœur</h2>
          <p>Chaque étape contient le noyau mémorable, l’erreur classique, une preuve dans ce starter et un exercice court.</p>
        </div>

        <div class="mastery-topics">
          {masteryTopics.map((topic, index) => (
            <article class="mastery-topic" id={topic.id} data-topic-article={topic.id}>
              <div class="mastery-topic__rail" aria-hidden="true">
                <span>{topic.rank.toString().padStart(2, '0')}</span>
                <span>{score(topic.score)}/20</span>
              </div>

              <div class="mastery-topic__content">
                <header>
                  <div>
                    <p>{topic.category}</p>
                    <h3>{topic.title}</h3>
                    <p>{topic.summary}</p>
                  </div>

                  <label class="mastery-check">
                    <input type="checkbox" value={topic.id} data-topic-toggle />
                    <span>Je maîtrise</span>
                  </label>
                </header>

                <details open={index < 3}>
                  <summary>Ouvrir la fiche de maîtrise</summary>
                  <div class="mastery-topic__details">
                    <section>
                      <h4>À savoir sans documentation</h4>
                      <ul>
                        {topic.remember.map((item) => <li set:html={item.replaceAll('`', '<code>').replaceAll('<code>', (match, offset, whole) => match)} />)}
                      </ul>
                    </section>

                    <section class="mastery-topic__trap">
                      <h4>Erreur coûteuse</h4>
                      <p>{topic.trap}</p>
                    </section>

                    <section>
                      <h4>Exercice de validation</h4>
                      <p>{topic.exercise}</p>
                    </section>

                    <section>
                      <h4>Preuves dans ce starter</h4>
                      <ul class="mastery-files">
                        {topic.repoExamples.map((file) => <li><code>{file}</code></li>)}
                      </ul>
                    </section>

                    <nav aria-label={`Documentation pour ${topic.title}`}>
                      <h4>Documentation officielle</h4>
                      <ul class="mastery-docs">
                        {topic.docs.map((doc) => (
                          <li><a href={doc.href} target="_blank" rel="noreferrer">{doc.label}<span aria-hidden="true"> ↗</span></a></li>
                        ))}
                      </ul>
                    </nav>
                  </div>
                </details>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="mastery-final" aria-labelledby="final-title">
        <h2 id="final-title">Le test qui prouve la maîtrise</h2>
        <p>
          Prends une fonctionnalité réelle — formulaire, blog CMS, espace connecté ou catalogue — et dessine avant de coder
          quatre frontières : <strong>build</strong>, <strong>requête</strong>, <strong>navigateur</strong> et <strong>plateforme</strong>.
          Si tu sais placer chaque donnée, composant et secret sans hésiter, tu raisonnes déjà comme un développeur Astro confirmé.
        </p>
        <a href="#mastery-title">Revenir au début</a>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const storageKey = 'astro-starter:mastery:v1';
  const toggles = Array.from(document.querySelectorAll<HTMLInputElement>('[data-topic-toggle]'));
  const progress = document.querySelector<HTMLProgressElement>('[data-progress-bar]');
  const count = document.querySelector<HTMLElement>('[data-progress-count]');
  const reset = document.querySelector<HTMLButtonElement>('[data-reset-progress]');

  const readProgress = (): Set<string> => {
    try {
      const saved = JSON.parse(localStorage.getItem(storageKey) ?? '[]');
      return new Set(Array.isArray(saved) ? saved.filter((item): item is string => typeof item === 'string') : []);
    } catch {
      return new Set();
    }
  };

  let completed = readProgress();

  const renderProgress = () => {
    for (const toggle of toggles) {
      const checked = completed.has(toggle.value);
      toggle.checked = checked;
      const article = document.querySelector<HTMLElement>(`[data-topic-article="${toggle.value}"]`);
      article?.classList.toggle('is-mastered', checked);
      const state = document.querySelector<HTMLElement>(`[data-topic-state="${toggle.value}"]`);
      if (state) state.textContent = checked ? 'Maîtrisé' : 'À apprendre';
    }

    if (progress) progress.value = completed.size;
    if (count) count.textContent = `${completed.size} / ${toggles.length}`;
  };

  for (const toggle of toggles) {
    toggle.addEventListener('change', () => {
      if (toggle.checked) completed.add(toggle.value);
      else completed.delete(toggle.value);
      localStorage.setItem(storageKey, JSON.stringify([...completed]));
      renderProgress();
    });
  }

  reset?.addEventListener('click', () => {
    completed = new Set();
    localStorage.removeItem(storageKey);
    renderProgress();
  });

  renderProgress();
</script>

<style>
  :global(.mastery-page) {
    --mastery-max: 72rem;
    background: var(--color-surface);
  }

  :global(.mastery-page *) {
    box-sizing: border-box;
  }

  .mastery-header {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    width: min(100% - 2rem, var(--mastery-max));
    margin-inline: auto;
    padding-block: 1rem;
    border-block-end: 1px solid var(--color-border);
  }

  .mastery-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .mastery-brand span:first-child {
    display: grid;
    width: 2.4rem;
    aspect-ratio: 1;
    place-items: center;
    background: var(--color-brand);
    color: var(--color-brand-contrast);
    font-size: 0.95rem;
  }

  .mastery-header nav {
    display: none;
    gap: 1.5rem;
  }

  .mastery-header nav a,
  .mastery-final a {
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: 650;
    text-underline-offset: 0.25em;
  }

  .mastery-internal {
    grid-column: 2;
    grid-row: 1;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mastery-hero {
    display: grid;
    gap: clamp(2.5rem, 7vw, 6rem);
    width: min(100% - 2rem, var(--mastery-max));
    margin-inline: auto;
    padding-block: clamp(4rem, 10vw, 9rem);
  }

  .mastery-hero h1 {
    max-width: 12ch;
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 760;
    line-height: 0.93;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .mastery-hero__copy > p {
    max-width: 62ch;
    margin-block-start: 2rem;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .mastery-score {
    align-self: end;
    max-width: 26rem;
    border-block-start: 4px solid var(--color-brand);
    padding-block-start: 1.25rem;
  }

  .mastery-score__formula {
    color: var(--color-brand);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-variant-numeric: tabular-nums;
    font-weight: 760;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .mastery-score > p + p {
    margin-block-start: 0.9rem;
  }

  .mastery-score__note {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .mastery-progress {
    display: grid;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem max(1rem, calc((100% - var(--mastery-max)) / 2));
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .mastery-progress h2 {
    font-size: 1rem;
  }

  .mastery-progress p {
    color: color-mix(in oklch, var(--color-surface) 72%, transparent);
    font-size: 0.85rem;
  }

  .mastery-progress strong {
    color: var(--color-surface);
    font-variant-numeric: tabular-nums;
  }

  .mastery-progress progress {
    width: 100%;
    height: 0.65rem;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background: color-mix(in oklch, var(--color-surface) 15%, transparent);
  }

  .mastery-progress progress::-webkit-progress-bar {
    background: color-mix(in oklch, var(--color-surface) 15%, transparent);
  }

  .mastery-progress progress::-webkit-progress-value {
    background: var(--color-brand);
  }

  .mastery-progress progress::-moz-progress-bar {
    background: var(--color-brand);
  }

  .mastery-progress button {
    justify-self: start;
    min-inline-size: auto;
    border: 1px solid color-mix(in oklch, var(--color-surface) 35%, transparent);
    border-radius: var(--radius-base);
    background: transparent;
    padding: 0.6rem 0.85rem;
    color: var(--color-surface);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .mastery-shell {
    width: min(100% - 2rem, var(--mastery-max));
    margin-inline: auto;
  }

  .mastery-method {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .mastery-method h2,
  .mastery-section-heading h2,
  .mastery-final h2 {
    max-width: 15ch;
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .mastery-method ol {
    display: grid;
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: method;
  }

  .mastery-method li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-block-start: 1px solid var(--color-border);
    counter-increment: method;
  }

  .mastery-method li::before {
    content: counter(method, decimal-leading-zero);
    color: var(--color-brand);
    font-variant-numeric: tabular-nums;
    font-weight: 750;
  }

  .mastery-ranking,
  .mastery-curriculum {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .mastery-section-heading {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-block-end: 3rem;
  }

  .mastery-section-heading > p {
    max-width: 58ch;
    color: var(--color-muted);
  }

  .mastery-table-wrap {
    overflow-x: auto;
  }

  .mastery-ranking table {
    width: 100%;
    min-width: 48rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .mastery-ranking th,
  .mastery-ranking td {
    padding: 1rem 0.75rem;
    border-block-end: 1px solid var(--color-border);
    text-align: left;
    vertical-align: middle;
  }

  .mastery-ranking thead th {
    color: var(--color-muted);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mastery-ranking tbody th {
    font-size: 1rem;
  }

  .mastery-ranking tbody a {
    color: inherit;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.2em;
  }

  .mastery-rank {
    color: var(--color-brand);
    font-variant-numeric: tabular-nums;
    font-weight: 750;
  }

  .mastery-state {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    white-space: nowrap;
  }

  .mastery-topics {
    border-block-start: 1px solid var(--color-border);
  }

  .mastery-topic {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    scroll-margin-top: 1rem;
    border-block-end: 1px solid var(--color-border);
  }

  .mastery-topic__rail {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 1.5rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    font-weight: 750;
  }

  .mastery-topic__rail span:first-child {
    color: var(--color-brand);
    font-size: 1rem;
  }

  .mastery-topic__content {
    min-width: 0;
    border-inline-start: 1px solid var(--color-border);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .mastery-topic__content > header {
    display: grid;
    gap: 1.5rem;
  }

  .mastery-topic__content > header > div > p:first-child {
    color: var(--color-brand);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mastery-topic h3 {
    margin-block-start: 0.35rem;
    font-size: clamp(1.65rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .mastery-topic h3 + p {
    max-width: 65ch;
    margin-block-start: 0.8rem;
    color: var(--color-muted);
  }

  .mastery-check {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.65rem;
    min-block-size: 48px;
    cursor: pointer;
  }

  .mastery-check input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--color-brand);
  }

  .mastery-check span {
    font-size: 0.9rem;
    font-weight: 700;
  }

  .mastery-topic details {
    margin-block-start: 1.75rem;
  }

  .mastery-topic summary {
    width: fit-content;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.25em;
  }

  .mastery-topic__details {
    display: grid;
    gap: 2rem;
    margin-block-start: 2rem;
  }

  .mastery-topic__details section,
  .mastery-topic__details nav {
    max-width: 68ch;
  }

  .mastery-topic__details h4 {
    margin-block-end: 0.75rem;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mastery-topic__details ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-inline-start: 1.2rem;
  }

  .mastery-topic__details code {
    border-radius: 0.25rem;
    background: color-mix(in oklch, var(--color-ink) 7%, transparent);
    padding: 0.08em 0.3em;
    font-size: 0.9em;
  }

  .mastery-topic__trap {
    border-block: 1px solid var(--color-border);
    padding-block: 1.25rem;
  }

  .mastery-files,
  .mastery-docs {
    list-style: none;
    padding: 0 !important;
  }

  .mastery-docs a {
    color: var(--color-brand);
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  .mastery-topic.is-mastered {
    background: color-mix(in oklch, var(--color-brand) 4%, transparent);
  }

  .mastery-topic.is-mastered .mastery-topic__rail span:first-child,
  .mastery-topic.is-mastered .mastery-topic__content > header > div > p:first-child {
    color: var(--color-ink);
  }

  .mastery-final {
    display: grid;
    gap: 2rem;
    margin-block: clamp(4rem, 10vw, 10rem) 3rem;
    border-block-start: 4px solid var(--color-brand);
    padding-block-start: 2rem;
  }

  .mastery-final p {
    max-width: 68ch;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .mastery-final a {
    justify-self: start;
  }

  @media (min-width: 48rem) {
    .mastery-header {
      grid-template-columns: 1fr auto auto;
    }

    .mastery-header nav {
      display: flex;
    }

    .mastery-internal {
      grid-column: 3;
    }

    .mastery-hero {
      grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr);
      align-items: end;
    }

    .mastery-progress {
      grid-template-columns: minmax(11rem, auto) minmax(14rem, 1fr) auto;
      gap: 2rem;
    }

    .mastery-progress button {
      justify-self: end;
    }

    .mastery-method,
    .mastery-section-heading {
      grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
    }

    .mastery-topic {
      grid-template-columns: 4.75rem minmax(0, 1fr);
    }

    .mastery-topic__content > header {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }

    .mastery-check {
      justify-self: end;
    }

    .mastery-topic__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mastery-topic__trap {
      border-block: 0;
      border-inline-start: 1px solid var(--color-border);
      padding-block: 0;
      padding-inline-start: 2rem;
    }

    .mastery-final {
      grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
    }

    .mastery-final a {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mastery-page) {
      scroll-behavior: auto;
    }
  }
</style>
