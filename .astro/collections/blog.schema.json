{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 15,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 70,
      "maxLength": 160
    },
    "heading": {
      "type": "string",
      "minLength": 10,
      "maxLength": 90
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "image": {
      "type": "string"
    },
    "noindex": {
      "default": false,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "primaryKeyword": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "publishedAt"
  ]
}