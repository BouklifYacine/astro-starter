# Public deployment URL. Astro inlines public values during the build.
SITE_URL=https://example.com

# Public client configuration. Leave empty to keep the related integration inactive.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only provider configuration. In production, use Cloudflare secrets or
# the equivalent secret store of the selected host.
TURNSTILE_SECRET_KEY=
N8N_LEADS_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional runtime destination used by the success response.
CAL_BOOKING_URL=
